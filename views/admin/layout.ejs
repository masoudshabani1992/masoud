<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <title><%= title %> | پنل مدیریت کوشا خودرو</title>
  <link rel="preload" href="/fonts/Vazirmatn.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<div class="layout">
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-head">
      <div class="logo">
        <i>ک</i>
        <div>کوشا خودرو<small>پنل مدیریت محتوا</small></div>
      </div>
    </div>

    <div class="nav-group">
      <div class="nav-title">محتوا</div>
      <nav>
        <a href="/admin" class="<%= active === 'dashboard' ? 'active' : '' %>"><span class="ico">▤</span> داشبورد</a>
        <a href="/admin/slides" class="<%= active === 'slides' ? 'active' : '' %>"><span class="ico">🎞</span> اسلایدر</a>
        <a href="/admin/news" class="<%= active === 'news' ? 'active' : '' %>"><span class="ico">📰</span> اخبار</a>
        <a href="/admin/circulars" class="<%= active === 'circulars' ? 'active' : '' %>"><span class="ico">📋</span> بخشنامه‌ها</a>
        <a href="/admin/pages" class="<%= active === 'pages' ? 'active' : '' %>"><span class="ico">📄</span> صفحات</a>
        <a href="/admin/products" class="<%= active === 'products' ? 'active' : '' %>"><span class="ico">🚗</span> محصولات</a>
        <a href="/admin/dealers" class="<%= active === 'dealers' ? 'active' : '' %>"><span class="ico">📍</span> نمایندگی‌ها</a>
        <a href="/admin/prices" class="<%= active === 'prices' ? 'active' : '' %>"><span class="ico">🧾</span> لیست قیمت</a>
        <a href="/admin/categories" class="<%= active === 'categories' ? 'active' : '' %>"><span class="ico">🏷</span> دسته‌بندی‌ها</a>
        <a href="/admin/media" class="<%= active === 'media' ? 'active' : '' %>"><span class="ico">🖼</span> رسانه</a>
      </nav>
    </div>

    <div class="nav-group">
      <div class="nav-title">سئو و کاربران</div>
      <nav>
        <a href="/admin/seo" class="<%= active === 'seo' ? 'active' : '' %>"><span class="ico">📈</span> سئو</a>
        <a href="/admin/inquiries" class="<%= active === 'inquiries' ? 'active' : '' %>"><span class="ico">✉</span> استعلام‌ها</a>
        <a href="/admin/settings" class="<%= active === 'settings' ? 'active' : '' %>"><span class="ico">⚙</span> تنظیمات</a>
        <% if (admin && admin.role === 'admin') { %>
          <a href="/admin/users" class="<%= active === 'users' ? 'active' : '' %>"><span class="ico">👤</span> کاربران</a>
        <% } %>
      </nav>
    </div>

    <div class="sidebar-foot">
      نسخه ۱.۰ · <a href="/" target="_blank" style="color:#9fb6cc">مشاهده سایت ↗</a>
    </div>
  </aside>

  <div class="main">
    <header class="topbar">
      <button class="menu-btn" onclick="document.getElementById('sidebar').classList.toggle('open')">☰</button>
      <span class="page-title"><%= title %></span>
      <span class="spacer"></span>
      <a class="view-site" href="/" target="_blank">مشاهده سایت ↗</a>
      <span class="user">
        <span class="avatar"><%= (admin ? admin.name : 'م').trim().slice(0, 1) %></span>
        <span>
          <b style="display:block;font-size:12.5px"><%= admin ? admin.name : '' %></b>
          <small class="muted" style="font-size:11px"><%= admin && admin.role === 'admin' ? 'مدیر کل' : 'ویرایشگر' %></small>
        </span>
      </span>
      <form method="post" action="/admin/logout" style="margin:0">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button class="btn btn-ghost btn-sm" type="submit">خروج</button>
      </form>
    </header>

    <div class="content">
      <% if (typeof flashMsg !== 'undefined' && flashMsg) { %>
        <div class="alert alert-<%= flashType %>">
          <span><%= flashType === 'success' ? '✓' : '!' %></span>
          <span><%= flashMsg %></span>
        </div>
      <% } %>
      <%- body %>
    </div>
  </div>
</div>
<script>
  // نمایش پیام موفقیت پس از عملیات
  document.querySelectorAll('form[data-confirm]').forEach(function (f) {
    f.addEventListener('submit', function (e) {
      if (!confirm(f.getAttribute('data-confirm'))) e.preventDefault();
    });
  });
  // باز/بستن سایدبار با کلیک بیرون
  document.addEventListener('click', function (e) {
    var sb = document.getElementById('sidebar');
    if (sb && sb.classList.contains('open') && !sb.contains(e.target) && !e.target.classList.contains('menu-btn')) {
      sb.classList.remove('open');
    }
  });
  function copyText(text) {
    navigator.clipboard && navigator.clipboard.writeText(text);
  }
</script>
<%- typeof extraScript !== 'undefined' ? extraScript : '' %>
</body>
</html>
