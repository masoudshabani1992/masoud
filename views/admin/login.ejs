<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <title>ورود به پنل مدیریت | کوشا خودرو</title>
  <link rel="preload" href="/fonts/Vazirmatn.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<div class="login-wrap">
  <div class="login-card">
    <div class="logo">
      <i>ک</i>
      <div>
        <h1>پنل مدیریت کوشا خودرو</h1>
      </div>
    </div>
    <p class="sub">برای ادامه، وارد حساب کاربری خود شوید.</p>

    <% if (error) { %>
      <div class="alert alert-error"><span>!</span><span><%= error %></span></div>
    <% } %>

    <form method="post" action="/admin/login">
      <input type="hidden" name="next" value="<%= next %>">
      <div class="field">
        <label>ایمیل</label>
        <input type="email" name="email" value="<%= email %>" required autofocus autocomplete="username" placeholder="admin@kooshakhodro.com">
      </div>
      <div class="field">
        <label>رمز عبور</label>
        <input type="password" name="password" required autocomplete="current-password" placeholder="••••••••">
      </div>
      <button class="btn btn-primary" type="submit">ورود به پنل</button>
    </form>

    <div class="login-foot">© کوشا خودرو — سامانه مدیریت محتوا</div>
  </div>
</div>
</body>
</html>
