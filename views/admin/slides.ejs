<div class="page-head">
  <div>
    <h1>اسلایدر صفحه اصلی</h1>
    <div class="sub">
      <%= U.toFa(rows.length) %> اسلاید · <%= U.toFa(rows.filter(function (r) { return r.active; }).length) %> فعال —
      ترتیب نمایش و متن‌ها را از اینجا مدیریت کنید
    </div>
  </div>
  <div class="actions">
    <a href="/admin/settings" class="btn btn-ghost">تنظیمات پخش خودکار</a>
    <a href="/" target="_blank" class="btn btn-ghost">مشاهده در سایت ↗</a>
    <a href="/admin/slides/new" class="btn btn-primary">+ اسلاید جدید</a>
  </div>
</div>

<% if (!rows.length) { %>
  <div class="card"><div class="empty">
    <div class="big">🎞</div>
    <p>هنوز اسلایدی ساخته نشده است. صفحه اصلی از طرح پیش‌فرض استفاده می‌کند.</p>
    <a href="/admin/slides/new" class="btn btn-primary">ساخت اولین اسلاید</a>
  </div></div>
<% } else { %>
  <div class="grid-2" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(330px,1fr));gap:18px">
    <% rows.forEach(function (sl, i) { %>
      <div class="panel" style="margin:0;overflow:hidden">
        <div style="position:relative;aspect-ratio:16/9;background:linear-gradient(135deg,#14508f,#07305e);display:flex;align-items:flex-end">
          <% if (sl.image_url) { %>
            <img src="<%= sl.image_url %>" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover">
          <% } %>
          <span style="position:absolute;inset:0;background:linear-gradient(to top,rgba(4,18,33,.92),rgba(4,18,33,.25))"></span>
          <div style="position:relative;padding:14px 16px;color:#fff">
            <span class="badge" style="background:var(--accent);color:#fff;margin-bottom:6px"><%= U.toFa(i + 1) %></span>
            <% if (!sl.active) { %><span class="badge badge-draft" style="margin-inline-start:4px">غیرفعال</span><% } %>
            <div style="font-weight:800;font-size:14px;line-height:1.7;margin-top:4px"><%= U.truncate(sl.title, 58) %></div>
            <div style="font-size:11.5px;opacity:.85;margin-top:3px"><%= U.truncate(sl.subtitle, 70) %></div>
          </div>
        </div>
        <div class="panel-body" style="padding:14px 16px;display:grid;gap:10px">
          <div class="small muted" style="display:flex;gap:14px;flex-wrap:wrap">
            <span>چیدمان: <%= alignment[sl.align] %></span>
            <span>تیرگی: <%= U.toFa(sl.overlay) %>٪</span>
            <span>دکمه‌ها: <%= U.toFa([sl.btn1_label, sl.btn2_label].filter(Boolean).length) %></span>
          </div>
          <div style="display:flex;gap:5px;flex-wrap:wrap">
            <a class="btn btn-ghost btn-xs" href="/admin/slides/<%= sl.id %>/edit">ویرایش</a>
            <form method="post" action="/admin/slides/<%= sl.id %>/toggle" style="display:inline">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <button class="btn btn-ghost btn-xs" type="submit"><%= sl.active ? 'غیرفعال' : 'فعال' %></button>
            </form>
            <form method="post" action="/admin/slides/<%= sl.id %>/move" style="display:inline">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <input type="hidden" name="dir" value="up">
              <button class="btn btn-ghost btn-xs" type="submit" <%= i === 0 ? 'disabled' : '' %>>↑</button>
            </form>
            <form method="post" action="/admin/slides/<%= sl.id %>/move" style="display:inline">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <input type="hidden" name="dir" value="down">
              <button class="btn btn-ghost btn-xs" type="submit" <%= i === rows.length - 1 ? 'disabled' : '' %>>↓</button>
            </form>
            <form method="post" action="/admin/slides/<%= sl.id %>/delete" style="display:inline" data-confirm="این اسلاید حذف شود؟">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <button class="btn btn-danger btn-xs" type="submit">حذف</button>
            </form>
          </div>
        </div>
      </div>
    <% }); %>
  </div>
<% } %>

<div class="panel" style="margin-top:22px">
  <div class="panel-head"><span>راهنما</span></div>
  <div class="panel-body small" style="line-height:2">
    <div>تصویر پیشنهادی: <b>۱۹۲۰×۱۰۸۰</b> پیکسل (افقی). بخش مهم تصویر را سمت چپ بگذارید تا متن روی آن نیفتد.</div>
    <div><b>تیرگی لایه:</b> مقدار بیشتر = متن خواناتر روی تصویرهای روشن.</div>
    <div>اسلایدهای غیرفعال در سایت نمایش داده نمی‌شوند؛ اما حذف نمی‌شوند و بعداً قابل فعال‌سازی هستند.</div>
    <div>مدت زمان هر اسلاید و پخش خودکار از <a href="/admin/settings">تنظیمات سایت</a> تغییر می‌کند.</div>
    <div>کاربران با «کاهش حرکت» در سیستم‌عامل، اسلایدر را بدون پخش خودکار می‌بینند.</div>
  </div>
</div>
