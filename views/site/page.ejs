<section class="page-hero">
  <div class="wrap">
    <nav class="crumbs" aria-label="مسیر صفحه">
      <a href="/">خانه</a><span class="sep">/</span><span class="current"><%= p.title %></span>
    </nav>
    <h1><%= p.title %></h1>
  </div>
</section>

<div class="wrap">
  <div class="article-layout">
    <article>
      <% if (coverImg) { %>
        <div style="border:1px solid var(--line);overflow:hidden;margin-bottom:28px">
          <img src="<%= coverImg.url %>" alt="<%= p.title %>" style="width:100%;aspect-ratio:16/9;object-fit:cover">
        </div>
      <% } %>
      <div class="content"><%- p.body || `<p>${p.excerpt || ''}</p>` %></div>
      <% if (p.slug === 'contact') { %>
        <div style="margin-top:26px;display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px">
          <div class="side-card" style="margin:0"><h3>تلفن</h3><b dir="ltr"><%= U.toFa(s.phone) %></b></div>
          <div class="side-card" style="margin:0"><h3>ایمیل</h3><b style="font-size:13px"><%= s.email %></b></div>
          <div class="side-card" style="margin:0"><h3>آدرس</h3><span style="font-size:13px"><%= s.address %></span></div>
        </div>
      <% } %>
    </article>
    <aside class="side">
      <div class="side-card">
        <h3>دسترسی سریع</h3>
        <ul class="side-list">
          <% menu.forEach(function (m) { %><li><a href="<%= m.url %>"><%= m.title %></a></li><% }); %>
        </ul>
      </div>
      <div class="side-card side-card-dark">
        <h3>تماس با ما</h3>
        <p>کارشناسان ما آمادهٔ پاسخگویی هستند.</p>
        <a href="/contact" class="btn btn-on-dark btn-sm" style="width:100%">درخواست تماس</a>
      </div>
    </aside>
  </div>
</div>
