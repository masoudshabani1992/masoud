<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= seo.title %></title>
  <meta name="description" content="<%= seo.description %>">
  <% if (seo.keywords) { %><meta name="keywords" content="<%= seo.keywords %>"><% } %>
  <meta name="robots" content="<%= seo.robots %>">
  <link rel="canonical" href="<%= seo.canonical %>">
  <% if (seo.prev) { %><link rel="prev" href="<%= seo.prev %>"><% } %>
  <% if (seo.next) { %><link rel="next" href="<%= seo.next %>"><% } %>

  <meta property="og:type" content="<%= seo.ogType %>">
  <meta property="og:site_name" content="<%= seo.siteName %>">
  <meta property="og:locale" content="fa_IR">
  <meta property="og:title" content="<%= seo.title %>">
  <meta property="og:description" content="<%= seo.description %>">
  <meta property="og:url" content="<%= seo.canonical %>">
  <% if (seo.image) { %>
    <meta property="og:image" content="<%= seo.image %>">
    <meta name="twitter:image" content="<%= seo.image %>">
    <meta name="twitter:card" content="summary_large_image">
  <% } else { %>
    <meta name="twitter:card" content="summary">
  <% } %>
  <meta name="twitter:title" content="<%= seo.title %>">
  <meta name="twitter:description" content="<%= seo.description %>">
  <% if (seo.publishedTime) { %><meta property="article:published_time" content="<%= seo.publishedTime %>"><% } %>
  <% if (seo.updatedTime) { %><meta property="article:modified_time" content="<%= seo.updatedTime %>"><% } %>
  <% if (s.google_site_verification) { %><meta name="google-site-verification" content="<%= s.google_site_verification %>"><% } %>

  <% if (s.favicon_url) { %><link rel="icon" href="<%= s.favicon_url %>"><% } else { %><link rel="icon" href="/favicon.svg" type="image/svg+xml"><% } %>
  <link rel="preload" href="/fonts/Vazirmatn.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/site.css">
  <link rel="alternate" type="application/rss+xml" title="<%= s.site_name %> — اخبار" href="/feed.xml">
  <% (seo.jsonLd || []).forEach(function (ld) { %>
  <script type="application/ld+json"><%- JSON.stringify(ld).replace(/</g, '\\u003c') %></script>
  <% }); %>
  <% if (s.google_analytics_id) { %>
  <script async src="https://www.googletagmanager.com/gtag/js?id=<%= s.google_analytics_id %>"></script>
  <script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','<%= s.google_analytics_id %>');</script>
  <% } %>
  <%- typeof extraHead !== 'undefined' ? extraHead : '' %>
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
<a href="#main" class="sr-only">پرش به محتوا</a>

<div class="hdr-bar">
  <div class="wrap">
    <div class="flex" style="gap:0">
      <a href="tel:<%= U.faToEnDigits(s.phone) %>" dir="ltr"><%= U.toFa(s.phone) %></a>
      <span class="sep">|</span>
      <span>شنبه تا چهارشنبه، ۸ تا ۱۷</span>
    </div>
    <div class="flex" style="gap:0">
      <a href="<%= s.sale_url %>" target="_blank" rel="noopener">سامانه فروش اینترنتی</a>
      <span class="sep">|</span>
      <a href="/circulars">بخشنامه‌های رسمی</a>
    </div>
  </div>
</div>

<header class="hdr" id="siteHeader">
  <div class="wrap">
    <a class="brandx" href="/" aria-label="<%= s.site_name %> — صفحه اصلی">
      <% if (s.logo_url) { %>
        <img src="<%= s.logo_url %>" alt="لوگوی <%= s.site_name %>" width="612" height="588">
      <% } else { %>
        <span class="brand-mark">ک</span>
      <% } %>
      <span class="bt"><b><%= s.site_name %></b><span><%= s.site_tagline %></span></span>
    </a>

    <button class="burgerx" type="button" aria-label="منو" aria-expanded="false"
            onclick="var n=document.querySelector('.navx');n.classList.toggle('open');this.setAttribute('aria-expanded',n.classList.contains('open'))">
      <span></span><span></span><span></span>
    </button>

    <nav class="navx" aria-label="منوی اصلی">
      <%
        // لینک فعال = طولانی‌ترین مسیر منطبق (تا /products و /prices همزمان فعال نشوند)
        var activeUrl = '';
        menu.forEach(function (m) {
          if (m.url === '/' ? path === '/' : path.indexOf(m.url) === 0) {
            if (m.url.length > activeUrl.length) activeUrl = m.url;
          }
        });
      %>
      <% menu.forEach(function (m) { %>
        <a href="<%= m.url %>" class="<%= m.url === activeUrl ? 'active' : '' %>"><%= m.title %></a>
      <% }); %>
      <a href="/search" style="font-size:13px;color:var(--muted)">جست‌وجو</a>
      <a href="/contact" class="btn btn-solid hdr-cta">استعلام قیمت</a>
    </nav>
  </div>
</header>

<main id="main">
  <%- body %>
</main>

<footer class="ftr">
  <div class="wrap">
    <div class="ftr-grid">
      <div>
        <a class="brandx" href="/" aria-label="<%= s.site_name %>">
          <% if (s.logo_dark_url) { %>
            <img src="<%= s.logo_dark_url %>" alt="لوگوی <%= s.site_name %>" width="612" height="588" loading="lazy">
          <% } else { %>
            <span class="brand-mark">ک</span>
          <% } %>
          <span class="bt"><b><%= s.site_name %></b><span><%= s.site_tagline %></span></span>
        </a>
        <p class="ftr-about"><%= s.footer_about %></p>
        <div class="socialx" style="margin-top:18px">
          <% if (s.social_instagram) { %><a href="<%= s.social_instagram %>" target="_blank" rel="noopener" aria-label="اینستاگرام">IG</a><% } %>
          <% if (s.social_telegram) { %><a href="<%= s.social_telegram %>" target="_blank" rel="noopener" aria-label="تلگرام">TG</a><% } %>
          <% if (s.social_linkedin) { %><a href="<%= s.social_linkedin %>" target="_blank" rel="noopener" aria-label="لینکدین">IN</a><% } %>
          <% if (s.social_aparat) { %><a href="<%= s.social_aparat %>" target="_blank" rel="noopener" aria-label="آپارات">AP</a><% } %>
        </div>
      </div>

      <div>
        <h4>دسترسی سریع</h4>
        <ul>
          <% menu.slice(0, 6).forEach(function (m) { %><li><a href="<%= m.url %>"><%= m.title %></a></li><% }); %>
        </ul>
      </div>

      <div>
        <h4>محصولات کیا</h4>
        <ul>
          <% (footerProducts || []).slice(0, 6).forEach(function (p) { %>
            <li><a href="/products/<%= p.slug %>"><%= p.name %></a></li>
          <% }); %>
          <li><a href="/products">همه محصولات</a></li>
        </ul>
      </div>

      <div>
        <h4>دفتر مرکزی</h4>
        <ul>
          <li><%= s.address %></li>
          <li>تلفن: <a href="tel:<%= U.faToEnDigits(s.phone) %>" dir="ltr"><%= U.toFa(s.phone) %></a></li>
          <% if (s.email) { %><li>ایمیل: <a href="mailto:<%= s.email %>"><%= s.email %></a></li><% } %>
          <li><a href="/contact">فرم تماس و نقشه</a></li>
        </ul>
      </div>
    </div>

    <div class="ftr-bottom">
      <span>© <%= year %> <%= s.site_name %> — تمامی حقوق محفوظ است.</span>
      <span>
        <a href="/p/privacy">حریم خصوصی</a><span class="sep">·</span>
        <a href="/p/terms">شرایط و قوانین</a><span class="sep">·</span>
        <a href="/sitemap.xml">نقشه سایت</a>
      </span>
    </div>
  </div>
</footer>

<script>
  (function () {
    // چسبیدن هدر + سایه
    var hdr = document.getElementById('siteHeader');
    if (hdr) {
      var onScroll = function () {
        hdr.classList.toggle('is-stuck', window.scrollY > 8);
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    }
    // جست‌وجوی سریع: ارسال خالی را متوقف کن
    document.querySelectorAll('[data-quick-search]').forEach(function (f) {
      f.addEventListener('submit', function (e) {
        var q = f.querySelector('input').value.trim();
        if (!q) e.preventDefault();
      });
    });
    // بستن منو با کلیک بیرون
    document.addEventListener('click', function (e) {
      var n = document.querySelector('.navx');
      var b = document.querySelector('.burgerx');
      if (!n || !n.classList.contains('open')) return;
      if (!n.contains(e.target) && !b.contains(e.target)) {
        n.classList.remove('open');
        b.setAttribute('aria-expanded', 'false');
      }
    });
  })();
</script>
<%- typeof extraScript !== 'undefined' ? extraScript : '' %>
</body>
</html>
