<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= seo.title %></title>
  <meta name="description" content="<%= seo.description %>">
  <% if (seo.keywords) { %><meta name="keywords" content="<%= seo.keywords %>"><% } %>
  <meta name="robots" content="<%= seo.robots %>">
  <link rel="canonical" href="<%= seo.canonical %>">
  <% if (seo.prev) { %><link rel="prev" href="<%= seo.prev %>"><% } %>
  <% if (seo.next) { %><link rel="next" href="<%= seo.next %>"><% } %>

  <meta property="og:type" content="<%= seo.ogType %>">
  <meta property="og:site_name" content="<%= seo.siteName %>">
  <meta property="og:locale" content="fa_IR">
  <meta property="og:title" content="<%= seo.title %>">
  <meta property="og:description" content="<%= seo.description %>">
  <meta property="og:url" content="<%= seo.canonical %>">
  <% if (seo.image) { %>
    <meta property="og:image" content="<%= seo.image %>">
    <meta name="twitter:image" content="<%= seo.image %>">
    <meta name="twitter:card" content="summary_large_image">
  <% } else { %>
    <meta name="twitter:card" content="summary">
  <% } %>
  <meta name="twitter:title" content="<%= seo.title %>">
  <meta name="twitter:description" content="<%= seo.description %>">
  <% if (seo.publishedTime) { %><meta property="article:published_time" content="<%= seo.publishedTime %>"><% } %>
  <% if (seo.updatedTime) { %><meta property="article:modified_time" content="<%= seo.updatedTime %>"><% } %>
  <% if (s.google_site_verification) { %><meta name="google-site-verification" content="<%= s.google_site_verification %>"><% } %>

  <% if (s.favicon_url) { %><link rel="icon" href="<%= s.favicon_url %>"><% } else { %><link rel="icon" href="/favicon.svg" type="image/svg+xml"><% } %>
  <link rel="preload" href="/fonts/Vazirmatn.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/site.css">
  <link rel="alternate" type="application/rss+xml" title="<%= s.site_name %> — اخبار" href="/feed.xml">
  <% (seo.jsonLd || []).forEach(function (ld) { %>
  <script type="application/ld+json"><%- JSON.stringify(ld).replace(/</g, '\\u003c') %></script>
  <% }); %>
  <% if (s.google_analytics_id) { %>
  <script async src="https://www.googletagmanager.com/gtag/js?id=<%= s.google_analytics_id %>"></script>
  <script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','<%= s.google_analytics_id %>');</script>
  <% } %>
  <%- typeof extraHead !== 'undefined' ? extraHead : '' %>
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
<a href="#main" class="sr-only">پرش به محتوا</a>

<div class="topbar">
  <div class="container">
    <div class="topbar-links">
      <span class="tb-hours">شنبه تا چهارشنبه ۸ تا ۱۷ &middot; پنجشنبه ۸ تا ۱۳</span>
      <span class="sep">|</span>
      <a href="tel:<%= U.faToEnDigits(s.phone) %>" class="tb-phone">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.5.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.9 21 3 13.1 3 3.9 3 3.4 3.4 3 4 3h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.5.1.4 0 .8-.3 1l-2.2 2.3z"/></svg>
        <%= U.toFa(s.phone) %>
      </a>
    </div>
    <div class="topbar-links">
      <a href="/dealers">شبکه نمایندگی‌ها</a>
      <span class="sep">|</span>
      <a href="/p/about">درباره کوشا خودرو</a>
    </div>
  </div>
</div>

<header class="site-header" id="siteHeader">
  <div class="container">
    <a class="brand" href="/">
      <% if (s.logo_url) { %>
        <img src="<%= s.logo_url %>" alt="<%= s.site_name %>">
      <% } else { %>
        <span class="brand-mark">ک</span>
      <% } %>
      <span class="brand-text">
        <b><%= s.site_name %></b>
        <small><%= s.site_tagline %></small>
      </span>
    </a>

    <nav class="nav" aria-label="منوی اصلی" id="mainNav">
      <% menu.forEach(function (m) { %>
        <a href="<%= m.url %>" class="<%= (m.url === '/' ? path === '/' : path.startsWith(m.url)) ? 'active' : '' %>"><%= m.title %></a>
      <% }); %>
      <a href="<%= s.sale_url %>" class="nav-sale" target="_blank" rel="noopener">سامانه فروش</a>
    </nav>

    <div class="header-actions">
      <a href="tel:<%= U.faToEnDigits(s.phone) %>" class="header-call" aria-label="تماس با کوشا خودرو">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.5.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.9 21 3 13.1 3 3.9 3 3.4 3.4 3 4 3h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.5.1.4 0 .8-.3 1l-2.2 2.3z"/></svg>
        <span><small>تماس با ما</small><b><%= U.toFa(s.phone) %></b></span>
      </a>
      <a href="/contact" class="header-cta">درخواست مشاوره</a>
      <button class="burger" aria-label="منو" aria-expanded="false" aria-controls="mainNav"
              onclick="this.setAttribute('aria-expanded', this.getAttribute('aria-expanded') === 'true' ? 'false' : 'true'); document.getElementById('mainNav').classList.toggle('open'); this.classList.toggle('is-open');">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<main id="main">
  <%- body %>
</main>

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a class="brand" href="/">
          <span class="brand-mark">ک</span>
          <span><%= s.site_name %><small><%= s.site_tagline %></small></span>
        </a>
        <p><%= s.footer_about %></p>
        <div class="social">
          <% if (s.social_instagram) { %><a href="<%= s.social_instagram %>" target="_blank" rel="noopener" aria-label="اینستاگرام">ig</a><% } %>
          <% if (s.social_telegram) { %><a href="<%= s.social_telegram %>" target="_blank" rel="noopener" aria-label="تلگرام">tg</a><% } %>
          <% if (s.social_linkedin) { %><a href="<%= s.social_linkedin %>" target="_blank" rel="noopener" aria-label="لینکدین">in</a><% } %>
          <% if (s.social_aparat) { %><a href="<%= s.social_aparat %>" target="_blank" rel="noopener" aria-label="آپارات">ap</a><% } %>
        </div>
      </div>
      <div>
        <h4>دسترسی سریع</h4>
        <ul>
          <% menu.forEach(function (m) { %><li><a href="<%= m.url %>"><%= m.title %></a></li><% }); %>
        </ul>
      </div>
      <div>
        <h4>محصولات</h4>
        <ul>
          <% (footerProducts || []).forEach(function (p) { %>
            <li><a href="/products/<%= p.slug %>"><%= p.name %></a></li>
          <% }); %>
          <li><a href="/products">همه محصولات</a></li>
        </ul>
      </div>
      <div>
        <h4>تماس با ما</h4>
        <ul>
          <li>تلفن: <a href="tel:<%= U.faToEnDigits(s.phone) %>"><%= U.toFa(s.phone) %></a></li>
          <% if (s.email) { %><li>ایمیل: <a href="mailto:<%= s.email %>"><%= s.email %></a></li><% } %>
          <li><%= s.address %></li>
          <li><a href="<%= s.sale_url %>" target="_blank" rel="noopener">سامانه فروش اینترنتی</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom container" style="padding-inline:0">
      <span>© <%= year %> <%= s.site_name %> — تمامی حقوق محفوظ است.</span>
      <span>
        <a href="/p/privacy">حریم خصوصی</a> · <a href="/p/terms">شرایط و قوانین</a> ·
        <a href="/sitemap.xml">نقشه سایت</a>
      </span>
    </div>
  </div>
</footer>

<script src="/js/slider.js" defer></script>
<script>
  // سایه هدر هنگام اسکرول
  (function () {
    var h = document.getElementById('siteHeader');
    if (!h) return;
    var onScroll = function () { h.classList.toggle('is-stuck', window.scrollY > 8); };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  })();

  // جست‌وجوی سریع
  document.querySelectorAll('[data-quick-search]').forEach(function (f) {
    f.addEventListener('submit', function (e) {
      var q = f.querySelector('input').value.trim();
      if (!q) { e.preventDefault(); }
    });
  });
</script>
<%- typeof extraScript !== 'undefined' ? extraScript : '' %>
</body>
</html>
