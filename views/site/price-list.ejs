<section class="page-hero">
  <div class="wrap">
    <nav class="crumbs" aria-label="مسیر صفحه">
      <a href="/">خانه</a><span class="sep">/</span><a href="/prices">لیست قیمت</a><span class="sep">/</span>
      <span class="current"><%= U.truncate(pl.title, 50) %></span>
    </nav>
    <h1><%= pl.title %></h1>
    <div class="flex" style="gap:16px;margin-top:16px;font-size:12px;color:var(--muted-2)">
      <span class="badge badge-type"><%= scopeLabel %></span>
      <% if (pl.dealer_name) { %><span><a href="/dealers/<%= pl.dealer_slug %>" style="color:var(--ink)"><%= pl.dealer_name %></a></span><% } %>
      <% if (pl.effective_from || pl.effective_to) { %>
        <span>اعتبار: <%= U.faDate(pl.effective_from) %> تا <%= U.faDate(pl.effective_to) %></span>
      <% } %>
      <span><%= pl.customer_type === 'public' ? 'مشتری نهایی' : 'عاملیت / نمایندگی' %></span>
      <span><%= U.toFa(items.length) %> محصول</span>
    </div>
  </div>
</section>

<div class="wrap">
  <div class="article-layout">
    <article>
      <div class="table-wrap">
        <table class="data price-table">
          <thead>
            <tr>
              <th>#</th><th>محصول</th><th>مدل / رنگ</th><th>قیمت پایه</th><th>سهم عاملیت</th>
              <th>قیمت شما</th><th>مصرف‌کننده</th><th>موجودی</th><th>تحویل</th>
            </tr>
          </thead>
          <tbody>
            <% items.forEach(function (it, idx) { %>
              <tr>
                <td class="small muted"><%= U.toFa(idx + 1) %></td>
                <td class="title-cell">
                  <% if (it.product_slug) { %><a href="/products/<%= it.product_slug %>"><%= it.product_name %></a>
                  <% } else { %><%= it.label %><% } %>
                  <% if (it.note) { %><span class="slug"><%= it.note %></span><% } %>
                </td>
                <td class="small muted"><%= it.model_year || '—' %><br><%= it.color || '—' %></td>
                <td class="num"><%= U.money(it.base_price) || '—' %></td>
                <td class="num" style="color:var(--ok)"><%= U.money(it.dealer_discount) || '—' %></td>
                <td class="num" style="font-weight:800;font-size:14.5px"><%= U.money(it.final_price) || '—' %></td>
                <td class="num muted"><%= U.money(it.public_price) || '—' %></td>
                <td class="small"><%= it.stock ? U.toFa(it.stock) : '—' %></td>
                <td class="small"><%= it.delivery || '—' %></td>
              </tr>
            <% }); %>
            <% if (!items.length) { %>
              <tr><td colspan="9" class="muted small" style="text-align:center;padding:26px">قلمی برای این لیست ثبت نشده است.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <% if (pl.notes) { %>
        <div class="alert alert-info" style="margin-top:18px"><%= pl.notes %></div>
      <% } %>

      <div class="flex" style="justify-content:space-between;margin-top:26px;gap:12px">
        <button type="button" class="btn btn-solid btn-sm" onclick="window.print()">چاپ / ذخیرهٔ PDF</button>
        <a href="/prices" class="btn btn-line btn-sm">بازگشت به لیست قیمت</a>
      </div>
    </article>

    <aside class="side">
      <div class="side-card">
        <h3>اطلاعات لیست</h3>
        <div class="kv"><span>نوع</span><b><%= scopeLabel %></b></div>
        <div class="kv"><span>مخاطب</span><b><%= pl.customer_type === 'public' ? 'مشتری نهایی' : 'عاملیت / نمایندگی' %></b></div>
        <% if (pl.city) { %><div class="kv"><span>شهر</span><b><%= pl.city %></b></div><% } %>
        <div class="kv"><span>تعداد اقلام</span><b><%= U.toFa(items.length) %></b></div>
        <% if (pl.effective_from) { %><div class="kv"><span>اعتبار از</span><b><%= U.faDate(pl.effective_from) %></b></div><% } %>
        <% if (pl.effective_to) { %><div class="kv"><span>تا</span><b><%= U.faDate(pl.effective_to) %></b></div><% } %>
      </div>

      <div class="side-card side-card-dark">
        <h3>درخواست قیمت اختصاصی</h3>
        <p>برای دریافت لیست قیمت مخصوص عاملیت خود با واحد فروش شبکه تماس بگیرید.</p>
        <a href="/contact" class="btn btn-on-dark btn-sm" style="width:100%">درخواست تماس</a>
      </div>
    </aside>
  </div>
</div>
