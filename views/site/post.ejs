<%
  var isCircular = p.type === 'circular';
%>
<section class="page-hero<%= isCircular ? '' : '' %>">
  <div class="wrap">
    <nav class="crumbs" aria-label="مسیر صفحه">
      <a href="/">خانه</a><span class="sep">/</span>
      <a href="<%= base %>"><%= isCircular ? 'بخشنامه‌ها' : 'اخبار' %></a>
      <span class="sep">/</span><span class="current"><%= U.truncate(p.title, 58) %></span>
    </nav>
    <h1 style="font-size:clamp(23px,3.2vw,38px);line-height:1.6;max-width:30ch"><%= p.title %></h1>
    <div class="flex" style="gap:16px;margin-top:18px;font-size:12px;color:var(--muted-2)">
      <% if (p.cat_name) { %><span class="badge badge-type"><%= p.cat_name %></span><% } %>
      <span><%= U.faDate(p.published_at) %></span>
      <% if (isCircular && p.doc_number) { %><span>شمارهٔ بخشنامه: <b style="color:var(--ink)"><%= U.toFa(p.doc_number) %></b></span><% } %>
      <% if (isCircular && p.doc_date) { %><span>تاریخ صدور: <b style="color:var(--ink)"><%= U.faDate(p.doc_date) %></b></span><% } %>
      <span><%= U.toFa(readingTime) %> دقیقه مطالعه</span>
    </div>
  </div>
</section>

<div class="wrap">
  <div class="article-layout">
    <article>
      <% if (coverImg) { %>
        <div style="border:1px solid var(--line);overflow:hidden;margin-bottom:30px">
          <img src="<%= coverImg.url %>" alt="<%= coverImg.alt || p.title %>" style="width:100%;aspect-ratio:16/9;object-fit:cover">
        </div>
      <% } %>

      <% if (isCircular) { %>
        <div class="alert alert-info">
          <span style="font-size:17px;line-height:1">—</span>
          <div>
            این مطلب یک بخشنامهٔ رسمی است.
            <% if (p.doc_number) { %>شماره: <b><%= U.toFa(p.doc_number) %></b><% } %>
            <% if (p.doc_date) { %> — تاریخ صدور: <b><%= U.faDate(p.doc_date) %></b><% } %>
          </div>
        </div>
      <% } %>

      <div class="content">
        <%- p.body || '<p>' + (p.excerpt || '') + '</p>' %>
      </div>

      <% if (attachment) { %>
        <div style="margin-top:32px;border:1px solid var(--line);padding:18px 20px;background:var(--paper);display:flex;align-items:center;gap:14px;flex-wrap:wrap">
          <span class="catalog-icon" style="border-color:var(--ink);color:var(--ink)">FILE</span>
          <div style="flex:1;min-width:180px">
            <b style="display:block;font-size:13.5px">فایل پیوست بخشنامه</b>
            <small class="muted"><%= attachment.original_name || attachment.filename %></small>
          </div>
          <a class="btn btn-solid btn-sm" href="<%= attachment.url %>" download>دانلود فایل</a>
        </div>
      <% } %>

      <div style="margin-top:36px;padding-top:22px;border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;align-items:center">
        <div class="share">
          <span class="muted" style="font-size:12px">اشتراک‌گذاری:</span>
          <a href="https://t.me/share/url?url=<%= encodeURIComponent(seo.canonical) %>&text=<%= encodeURIComponent(p.title) %>" target="_blank" rel="noopener">تلگرام</a>
          <a href="https://wa.me/?text=<%= encodeURIComponent(p.title + ' ' + seo.canonical) %>" target="_blank" rel="noopener">واتساپ</a>
          <a href="https://twitter.com/intent/tweet?url=<%= encodeURIComponent(seo.canonical) %>&text=<%= encodeURIComponent(p.title) %>" target="_blank" rel="noopener">X</a>
          <a href="https://www.linkedin.com/sharing/share-offsite/?url=<%= encodeURIComponent(seo.canonical) %>" target="_blank" rel="noopener">لینکدین</a>
          <button type="button" onclick="navigator.clipboard&&navigator.clipboard.writeText(location.href).then(()=>this.textContent='کپی شد!')">کپی لینک</button>
        </div>
        <a href="<%= base %>" class="btn btn-line btn-sm">بازگشت به <%= isCircular ? 'بخشنامه‌ها' : 'اخبار' %></a>
      </div>
    </article>

    <aside class="side">
      <div class="side-card">
        <h3>مطالب مرتبط</h3>
        <ul class="side-list">
          <% related.forEach(function (r) { %>
            <li>
              <a href="<%= postUrl(r) %>" style="display:flex;gap:12px;align-items:center">
                <span style="flex:0 0 62px;height:46px;overflow:hidden;background:var(--paper);display:grid;place-items:center;font-size:11px;color:var(--muted-2)">
                  <% if (r.coverUrl) { %><img src="<%= r.coverUrl %>" alt="" style="width:100%;height:100%;object-fit:cover">
                  <% } else { %>KIA<% } %>
                </span>
                <span>
                  <b style="display:block;color:var(--ink);font-size:12.5px;line-height:1.8;font-weight:600"><%= U.truncate(r.title, 56) %></b>
                  <span class="date"><%= U.faDate(r.published_at) %></span>
                </span>
              </a>
            </li>
          <% }); %>
          <% if (!related.length) { %><li class="muted">مطلب مرتبطی یافت نشد.</li><% } %>
        </ul>
      </div>

      <div class="side-card">
        <h3>محصولات کیا</h3>
        <ul class="side-list">
          <% (footerProducts || []).forEach(function (pr) { %>
            <li><a href="/products/<%= pr.slug %>"><%= pr.name %></a></li>
          <% }); %>
        </ul>
        <a href="/products" class="btn btn-line btn-sm" style="width:100%;margin-top:14px">همهٔ محصولات</a>
      </div>

      <div class="side-card side-card-dark">
        <h3>سامانه فروش</h3>
        <p>ثبت‌نام و مشاهدهٔ شرایط فروش محصولات کیا</p>
        <a href="<%= s.sale_url %>" target="_blank" rel="noopener" class="btn btn-on-dark btn-sm" style="width:100%">ورود به سامانه</a>
      </div>
    </aside>
  </div>
</div>
