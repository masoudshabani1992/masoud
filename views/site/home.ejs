<% if (slides && slides.length) { %>
<section class="slider" id="heroSlider"
         data-autoplay="<%= s.slider_autoplay === '1' ? '1' : '0' %>"
         data-interval="<%= Number(s.slider_interval) || 6 %>"
         style="--dot-duration: <%= Number(s.slider_interval) || 6 %>s"
         aria-roledescription="carousel" aria-label="اسلایدهای معرفی کوشا خودرو">
  <div class="slider-track">
    <% slides.forEach(function (sl, i) { %>
      <div class="slide<%= i === 0 ? ' is-active' : '' %><%= sl.align === 'center' ? ' slide-center' : '' %>"
           role="group" aria-roledescription="slide" aria-label="<%= U.toFa(i + 1) %> از <%= U.toFa(slides.length) %>"
           <%= i === 0 ? '' : 'aria-hidden="true"' %>>
        <% if (sl.image_url) { %>
          <img class="slide-bg" src="<%= sl.image_url %>" alt="<%= sl.image_alt || '' %>"
               <%= i === 0 ? 'fetchpriority="high"' : 'loading="lazy"' %>>
        <% } else { %>
          <span class="slide-bg slide-bg-plain"></span>
        <% } %>
        <span class="slide-scrim" style="opacity:<%= (Number(sl.overlay) || 55) / 100 %>"></span>
        <div class="container">
          <div class="slide-content">
            <% if (sl.kicker) { %><span class="slide-kicker"><%= sl.kicker %></span><% } %>
            <%- i === 0 ? '<h1 class="slide-title">' : '<h2 class="slide-title">' %><%= sl.title %><%- i === 0 ? '</h1>' : '</h2>' %>
            <% if (sl.subtitle) { %><p class="slide-sub"><%= sl.subtitle %></p><% } %>
            <div class="slide-actions">
              <% if (sl.btn1_label) { %>
                <a class="btn btn-primary" href="<%= sl.btn1_url || '#' %>"><%= sl.btn1_label %></a>
              <% } %>
              <% if (sl.btn2_label) { %>
                <a class="btn btn-light" href="<%= sl.btn2_url || '#' %>"><%= sl.btn2_label %></a>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    <% }); %>
  </div>

  <div class="slider-ui">
    <div class="container slider-ui-inner">
      <div class="slider-dots" role="tablist" aria-label="انتخاب اسلاید">
        <% slides.forEach(function (sl, i) { %>
          <button type="button" class="slider-dot<%= i === 0 ? ' is-active' : '' %>" role="tab"
                  aria-selected="<%= i === 0 ? 'true' : 'false' %>"
                  aria-label="اسلاید <%= U.toFa(i + 1) %>" data-goto="<%= i %>">
            <span></span>
          </button>
        <% }); %>
      </div>
      <div class="slider-controls">
        <button type="button" class="slider-arrow" data-prev aria-label="اسلاید قبلی">‹</button>
        <span class="slider-count"><b>۱</b> / <%= U.toFa(slides.length) %></span>
        <button type="button" class="slider-arrow" data-next aria-label="اسلاید بعدی">›</button>
      </div>
    </div>
  </div>

  <div class="slider-hero-badges container">
    <div><b><%= U.toFa('25,000') %>+</b> خودروی واردشده</div>
    <div><b><%= U.toFa('30') %>+</b> نمایندگی فعال</div>
    <div><b><%= U.toFa('15') %></b> سال تجربه</div>
    <div><b>ISQI</b> رتبه نخست فروش ۱۴۰۳</div>
  </div>
</section>
<% } else { %>
<section class="hero">
  <div class="container">
    <span class="kicker" style="color:#ffd1d9">نماینده رسمی کیا در ایران</span>
    <h1>کیا را با خیال راحت از کوشا خودرو بخرید</h1>
    <p>از سال ۱۳۸۷ در کنار شما هستیم؛ واردات رسمی محصولات کیا و شبکه گسترده خدمات پس از فروش.</p>
    <div class="hero-actions">
      <a href="/products" class="btn btn-primary">مشاهده محصولات</a>
      <a href="/circulars" class="btn btn-light">بخشنامه‌ها</a>
    </div>
  </div>
</section>
<% } %>

<section class="stats">
  <div class="container" style="padding:0">
    <div class="stats-grid">
      <div><b><%= U.toFa('18') %></b><span>سال حضور در بازار خودرو</span></div>
      <div><b><%= U.toFa(productsCount) %></b><span>مدل خودروی کیا</span></div>
      <div><b><%= U.toFa('30') %>+</b><span>نمایندگی فروش و خدمات</span></div>
      <div><b>ISQI</b><span>رتبه نخست ارزیابی فروش ۱۴۰۳</span></div>
    </div>
  </div>
</section>

<!-- محصولات -->
<section class="block">
  <div class="container">
    <div class="section-head">
      <div>
        <span class="kicker">محصولات</span>
        <h2>محصولات کیا</h2>
        <p>مشخصات فنی، امکانات و شرایط فروش محصولات وارداتی</p>
      </div>
      <a class="more" href="/products">همه محصولات ←</a>
    </div>
    <div class="grid grid-4">
      <% featuredProducts.forEach(function (p) { %>
        <article class="card product-card">
          <a href="/products/<%= p.slug %>" class="card-thumb">
            <% if (p.coverUrl) { %>
              <img src="<%= p.coverUrl %>" alt="<%= p.name %>" loading="lazy">
            <% } else { %>
              <div class="placeholder">🚗</div>
            <% } %>
          </a>
          <div class="card-body">
            <div class="card-meta">
              <span class="tag"><%= p.model || 'KIA' %></span>
              <span class="badge badge-<%= p.status %>"><%= U.STATUS_LABELS[p.status] %></span>
            </div>
            <h3><a href="/products/<%= p.slug %>"><%= p.name %></a></h3>
            <p><%= U.truncate(p.short_desc, 88) %></p>
            <div class="foot">
              <span class="price">
                <% if (p.price) { %><%= U.money(p.price) %> <small>تومان</small><% } else { %>استعلام قیمت<% } %>
              </span>
              <a href="/products/<%= p.slug %>" class="btn btn-ghost btn-sm">جزئیات</a>
            </div>
          </div>
        </article>
      <% }); %>
    </div>
  </div>
</section>

<!-- اخبار -->
<% if (latestNews.length) { %>
<section class="block alt">
  <div class="container">
    <div class="section-head">
      <div>
        <span class="kicker">اخبار</span>
        <h2>آخرین اخبار</h2>
        <p>خبرهای کوشا خودرو و صنعت خودرو</p>
      </div>
      <a class="more" href="/news">آرشیو اخبار ←</a>
    </div>
    <div class="grid grid-3">
      <% latestNews.slice(0, 3).forEach(function (n) { %>
        <article class="card">
          <a href="/news/<%= n.slug %>" class="card-thumb">
            <% if (n.coverUrl) { %><img src="<%= n.coverUrl %>" alt="<%= n.title %>" loading="lazy">
            <% } else { %><div class="placeholder">📰</div><% } %>
          </a>
          <div class="card-body">
            <div class="card-meta">
              <% if (n.cat_name) { %><span class="tag"><%= n.cat_name %></span><% } %>
              <span><%= U.faDate(n.published_at) %></span>
            </div>
            <h3><a href="/news/<%= n.slug %>"><%= n.title %></a></h3>
            <p><%= U.truncate(n.excerpt || n.body, 110) %></p>
          </div>
        </article>
      <% }); %>
    </div>

    <% if (latestNews.length > 3) { %>
      <div class="grid grid-3" style="margin-top:24px">
        <% latestNews.slice(3, 6).forEach(function (n) { %>
          <a href="/news/<%= n.slug %>" style="display:flex;gap:14px;align-items:flex-start;background:#fff;border:1px solid var(--line);border-radius:12px;padding:14px 16px">
            <span style="flex:0 0 auto;width:72px;height:56px;border-radius:8px;overflow:hidden;background:#eef4fb;display:grid;place-items:center">
              <% if (n.coverUrl) { %><img src="<%= n.coverUrl %>" alt="" style="width:100%;height:100%;object-fit:cover">
              <% } else { %>📄<% } %>
            </span>
            <span>
              <b style="display:block;font-size:14px;color:var(--ink);line-height:1.7"><%= n.title %></b>
              <small style="color:var(--muted)"><%= U.faDate(n.published_at) %></small>
            </span>
          </a>
        <% }); %>
      </div>
    <% } %>
  </div>
</section>
<% } %>

<!-- بخشنامه‌ها -->
<% if (latestCirculars.length) { %>
<section class="block">
  <div class="container">
    <div class="section-head">
      <div>
        <span class="kicker">بخشنامه‌ها</span>
        <h2>بخشنامه‌ها و اطلاعیه‌های رسمی</h2>
        <p>دستورالعمل‌های فروش و خدمات پس از فروش برای مشتریان و نمایندگی‌ها</p>
      </div>
      <a class="more" href="/circulars">آرشیو بخشنامه‌ها ←</a>
    </div>
    <div class="grid grid-2">
      <% latestCirculars.forEach(function (c) { %>
        <a class="circular-item" href="/circular/<%= c.slug %>">
          <span class="circular-date">
            <b><%= U.faDateShort(c.doc_date || c.published_at).split('/')[2] || '—' %></b>
            <span><%= U.faDate(c.doc_date || c.published_at).split(' ').slice(0, 2).join(' ') %></span>
          </span>
          <span>
            <% if (c.doc_number) { %><span class="circular-num">شماره <%= U.toFa(c.doc_number) %></span><% } %>
            <h3><%= c.title %></h3>
            <p><%= U.truncate(c.excerpt || c.body, 110) %></p>
          </span>
        </a>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<!-- درباره -->
<section class="block alt">
  <div class="container">
    <div class="grid grid-2" style="align-items:center;gap:44px">
      <div>
        <span class="kicker">درباره کوشا خودرو</span>
        <h2 style="font-size:28px;margin-top:10px">بیش از یک دهه تجربه در واردات خودرو</h2>
        <p style="color:var(--muted)">
          کوشا خودرو از سال ۱۳۸۷ فعالیت خود را آغاز کرد و امروز به‌عنوان نماینده رسمی فروش و خدمات پس از فروش
          محصولات کیا در ایران شناخته می‌شود. تأمین قطعات اصلی، شبکه گسترده نمایندگی و خدمات پس از فروش،
          سه ستون اصلی تعهد ما به مشتریان است.
        </p>
        <ul style="color:#2c3e52;line-height:2.2;padding-inline-start:1.2em">
          <li>واردات رسمی محصولات کیا با گارانتی معتبر</li>
          <li>تأمین قطعات اصلی از کره جنوبی</li>
          <li>خدمات پس از فروش در بیش از ۳۰ نمایندگی</li>
          <li>رتبه نخست ارزیابی فروش ISQI در سال ۱۴۰۳</li>
        </ul>
        <a href="/p/about" class="btn btn-ghost" style="margin-top:12px">درباره ما بیشتر بدانید</a>
      </div>
      <div class="cta-band" style="flex-direction:column;align-items:flex-start;padding:36px">
        <h2 style="font-size:22px">مشاوره خرید خودرو</h2>
        <p>کارشناسان ما آماده پاسخگویی به سؤالات شما درباره محصولات، شرایط فروش و خدمات پس از فروش هستند.</p>
        <a href="/contact" class="btn btn-light" style="margin-top:14px">تماس با کارشناسان</a>
      </div>
    </div>
  </div>
</section>
