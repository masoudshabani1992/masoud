<section class="article-hero">
  <div class="container">
    <nav class="breadcrumb" aria-label="مسیر صفحه"><a href="/">خانه</a><span>/</span><span>جست‌وجو</span></nav>
    <h1 style="font-size:28px;margin:0 0 16px">جست‌وجو در سایت</h1>
    <form method="get" action="/search" style="display:flex;gap:10px;max-width:560px">
      <input class="input" style="flex:1;padding:12px 16px;border:1px solid var(--line);border-radius:10px;font-family:var(--font)" type="search" name="q" value="<%= q %>" placeholder="خبر، بخشنامه، محصول...">
      <button class="btn btn-primary" type="submit">جست‌وجو</button>
    </form>
  </div>
</section>

<div class="container">
  <div style="padding:36px 0 72px">
    <% if (!q) { %>
      <div class="empty-state"><div class="icon">🔍</div><h2>عبارت مورد نظر را وارد کنید</h2></div>
    <% } else { %>
      <p class="muted"><%= U.toFa(total) %> نتیجه برای «<b><%= q %></b>»</p>

      <% if (products.length) { %>
        <h2 style="font-size:19px;margin-top:28px">محصولات</h2>
        <div class="grid grid-3">
          <% products.forEach(function (p) { %>
            <a class="card" href="/products/<%= p.slug %>" style="flex-direction:row;align-items:center;padding:14px;gap:12px">
              <span style="flex:0 0 66px;height:52px;border-radius:8px;overflow:hidden;background:#eef4fb;display:grid;place-items:center">
                <% if (p.coverUrl) { %><img src="<%= p.coverUrl %>" alt="" style="width:100%;height:100%;object-fit:cover"><% } else { %>🚗<% } %>
              </span>
              <span><b style="color:var(--ink);font-size:14px"><%= p.name %></b>
                <small style="display:block;color:var(--muted)"><%= U.truncate(p.short_desc, 60) %></small></span>
            </a>
          <% }); %>
        </div>
      <% } %>

      <% if (news.length) { %>
        <h2 style="font-size:19px;margin-top:32px">اخبار</h2>
        <div class="grid" style="gap:12px">
          <% news.forEach(function (n) { %>
            <a class="circular-item" href="/<%= n.slug && n.__t ? "" : "" %>#" data-x>
              <span class="circular-date"><b>📰</b></span>
              <span><h3><%= n.title %></h3><p><%= U.truncate(n.excerpt, 130) %></p>
                <small class="muted"><%= U.faDate(n.published_at) %></small></span>
            </a>
          <% }); %>
        </div>
      <% } %>

      <% if (circulars.length) { %>
        <h2 style="font-size:19px;margin-top:32px">بخشنامه‌ها</h2>
        <div class="grid" style="gap:12px">
          <% circulars.forEach(function (c) { %>
            <a class="circular-item" href="/<%= c.slug && c.__t ? "" : "" %>#" data-x>
              <span class="circular-date"><b>📋</b></span>
              <span><h3><%= c.title %></h3>
                <small class="muted">
                  <% if (c.doc_number) { %>شماره <%= U.toFa(c.doc_number) %> — <% } %><%= U.faDate(c.doc_date || c.published_at) %>
                </small></span>
            </a>
          <% }); %>
        </div>
      <% } %>

      <% if (pages.length) { %>
        <h2 style="font-size:19px;margin-top:32px">صفحات</h2>
        <div class="grid" style="gap:12px">
          <% pages.forEach(function (p) { %>
            <a class="circular-item" href="/p/<%= p.slug %>">
              <span class="circular-date"><b>📄</b></span>
              <span><h3><%= p.title %></h3><p><%= U.truncate(p.excerpt, 130) %></p></span>
            </a>
          <% }); %>
        </div>
      <% } %>

      <% if (!total) { %>
        <div class="empty-state"><div class="icon">🤷</div><h2>نتیجه‌ای یافت نشد</h2>
          <p>عبارت دیگری را امتحان کنید یا از منوی سایت استفاده کنید.</p></div>
      <% } %>
    <% } %>
  </div>
</div>
