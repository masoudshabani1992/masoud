<section class="page-hero">
  <div class="wrap">
    <nav class="crumbs" aria-label="مسیر صفحه"><a href="/">خانه</a><span class="sep">/</span><span class="current">جست‌وجو</span></nav>
    <h1>جست‌وجو در سایت</h1>
    <form method="get" action="/search" style="display:flex;gap:10px;max-width:560px;margin-top:22px">
      <input type="search" name="q" value="<%= q %>" placeholder="خبر، بخشنامه، محصول..."
             style="flex:1;height:48px;border:1px solid var(--line);background:#fff;padding:0 16px;font-family:inherit;font-size:14px;border-radius:2px">
      <button class="btn btn-solid" type="submit">جست‌وجو</button>
    </form>
  </div>
</section>

<div class="wrap" style="padding-top:36px;padding-bottom:76px">
  <% if (!q) { %>
    <div class="empty-state"><div class="icon">—</div><h2>عبارت مورد نظر را وارد کنید</h2><p>نام خودرو، شمارهٔ بخشنامه یا موضوع خبر.</p></div>
  <% } else { %>
    <p class="muted" style="margin-bottom:26px"><%= U.toFa(total) %> نتیجه برای «<b style="color:var(--ink)"><%= q %></b>»</p>

    <% if (products.length) { %>
      <h2 style="font-size:18px;margin:30px 0 16px">محصولات</h2>
      <div class="grid grid-3">
        <% products.forEach(function (p) { %>
          <a class="card" href="/products/<%= p.slug %>" style="flex-direction:row;align-items:center;padding:14px;gap:12px">
            <span style="flex:0 0 66px;height:52px;overflow:hidden;background:var(--paper);display:grid;place-items:center;font-size:10px;color:var(--muted-2)">
              <% if (p.coverUrl) { %><img src="<%= p.coverUrl %>" alt="" style="width:100%;height:100%;object-fit:cover"><% } else { %>KIA<% } %>
            </span>
            <span>
              <b style="color:var(--ink);font-size:14px"><%= p.name %></b>
              <small style="display:block;color:var(--muted)"><%= U.truncate(p.short_desc, 56) %></small>
            </span>
          </a>
        <% }); %>
      </div>
    <% } %>

    <% if (news.length) { %>
      <h2 style="font-size:18px;margin:34px 0 16px">اخبار</h2>
      <div class="side-card">
        <ul class="side-list">
          <% news.forEach(function (n) { %>
            <li>
              <a href="/news/<%= n.slug %>"><b style="font-weight:600"><%= n.title %></b></a>
              <span class="date"><%= U.faDate(n.published_at) %></span>
            </li>
          <% }); %>
        </ul>
      </div>
    <% } %>

    <% if (circulars.length) { %>
      <h2 style="font-size:18px;margin:34px 0 16px">بخشنامه‌ها</h2>
      <div class="side-card">
        <ul class="side-list">
          <% circulars.forEach(function (c) { %>
            <li>
              <a href="/circular/<%= c.slug %>"><b style="font-weight:600"><%= c.title %></b></a>
              <span class="date">
                <% if (c.doc_number) { %>شمارهٔ <%= U.toFa(c.doc_number) %> — <% } %><%= U.faDate(c.doc_date || c.published_at) %>
              </span>
            </li>
          <% }); %>
        </ul>
      </div>
    <% } %>

    <% if (pages.length) { %>
      <h2 style="font-size:18px;margin:34px 0 16px">صفحات</h2>
      <div class="side-card">
        <ul class="side-list">
          <% pages.forEach(function (p) { %>
            <li><a href="/p/<%= p.slug %>"><b style="font-weight:600"><%= p.title %></b></a><span class="date"><%= U.truncate(p.excerpt, 110) %></span></li>
          <% }); %>
        </ul>
      </div>
    <% } %>

    <% if (!total) { %>
      <div class="empty-state"><div class="icon">—</div><h2>نتیجه‌ای یافت نشد</h2><p>عبارت دیگری را امتحان کنید یا از منوی سایت استفاده کنید.</p></div>
    <% } %>
  <% } %>
</div>
