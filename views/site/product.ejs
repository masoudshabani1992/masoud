<section class="prod-hero">
  <div class="wrap">
    <nav class="crumbs" aria-label="مسیر صفحه">
      <a href="/">خانه</a><span class="sep">/</span><a href="/products">محصولات</a><span class="sep">/</span><span class="current"><%= p.name %></span>
    </nav>

    <div class="ph-grid">
      <div>
        <span class="ph-latin"><%= p.cat_name || 'KIA MOTORS' %></span>
        <h1 class="ph-title"><%= p.name %></h1>
        <p class="ph-sub"><%= U.truncate(p.short_desc, 200) %></p>

        <div class="ph-price-box">
          <div class="ph-price">
            <% if (p.price) { %><%= U.money(p.price) %> <small>تومان</small><% } else { %>استعلام قیمت<% } %>
          </div>
          <% if (p.price_note) { %><span class="ph-price-note"><%= p.price_note %></span><% } %>
        </div>

        <div class="ph-btns">
          <% if (brochure) { %>
            <a class="btn btn-on-dark" href="<%= brochure.url %>" target="_blank" rel="noopener">دانلود کاتالوگ PDF</a>
          <% } else { %>
            <a class="btn btn-on-dark" href="#catalog">کاتالوگ محصول</a>
          <% } %>
          <a class="btn btn-outline-dark" href="#inquiry">استعلام قیمت</a>
          <a class="btn btn-outline-dark" href="tel:<%= U.faToEnDigits(s.sales_phone || s.phone) %>" dir="ltr"><%= U.toFa(s.sales_phone || s.phone) %></a>
        </div>
      </div>

      <div class="ph-media">
        <% if (coverImg) { %>
          <img src="<%= coverImg.url %>" alt="<%= coverImg.alt || p.name %>" fetchpriority="high">
        <% } else { %>
          <span class="placeholder" style="height:100%;background:#141519;color:#4a4a4f">KIA</span>
        <% } %>
      </div>
    </div>
  </div>

  <div class="spec-strip">
    <div class="wrap" style="padding:0">
      <div class="spec-strip-grid">
        <div><span>پیشرانه</span><b><%= p.engine || '—' %></b></div>
        <div><span>گیربکس</span><b><%= p.transmission || '—' %></b></div>
        <div><span>سوخت</span><b><%= p.fuel || '—' %></b></div>
        <div><span>وضعیت عرضه</span><b><%= U.STATUS_LABELS[p.status] || 'موجود' %></b></div>
      </div>
    </div>
  </div>
</section>

<div class="pd-body">
  <div class="wrap">
    <div class="pd-layout">
      <div>
        <section class="pd-section" id="catalog">
          <h2>کاتالوگ محصول</h2>
          <% if (brochure) { %>
            <div class="catalog-card">
              <div class="catalog-icon">PDF</div>
              <div style="flex:1;min-width:180px">
                <h3>کاتالوگ رسمی <%= p.name %></h3>
                <p><%= brochureMeta.tagline || 'مشخصات فنی، امکانات و شرایط فروش' %></p>
              </div>
              <div class="catalog-actions">
                <a class="btn btn-on-dark btn-sm" href="<%= brochure.url %>" download>دانلود کاتالوگ</a>
                <a class="btn btn-outline-dark btn-sm" href="<%= brochure.url %>" target="_blank" rel="noopener">مشاهدهٔ آنلاین</a>
              </div>
            </div>
          <% } else { %>
            <div class="catalog-card">
              <div class="catalog-icon">PDF</div>
              <div style="flex:1;min-width:180px">
                <h3>کاتالوگ مشخصات <%= p.name %></h3>
                <p>همان اطلاعات این صفحه به‌صورت یک بروشور قابل چاپ و ذخیره؛ بدون نیاز به دانلود.</p>
              </div>
              <div class="catalog-actions">
                <button type="button" class="btn btn-on-dark btn-sm" onclick="window.print()">چاپ / ذخیرهٔ PDF</button>
              </div>
            </div>
          <% } %>

          <% if (brochureMeta && brochureMeta.highlights && brochureMeta.highlights.length) { %>
            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:10px;margin-top:14px">
              <% brochureMeta.highlights.forEach(function (h) { %>
                <div style="border:1px solid var(--line-dark-2);padding:14px 16px;background:var(--ink-2)">
                  <span style="display:block;width:14px;height:1px;background:var(--sand);margin-bottom:10px"></span>
                  <span style="font-size:13px;color:#d5d3cd;line-height:1.9"><%= h %></span>
                </div>
              <% }); %>
            </div>
          <% } %>
        </section>

        <% if (p.body) { %>
          <section class="pd-section">
            <h2>معرفی و مشخصات</h2>
            <div class="content"><%- p.body %></div>
          </section>
        <% } %>

        <% if (specs.length) { %>
          <section class="pd-section">
            <h2>جدول مشخصات فنی</h2>
            <table class="pd-spec-table">
              <tbody>
                <% specs.forEach(function (sp) { %>
                  <tr><th><%= sp.label %></th><td><%= sp.value %></td></tr>
                <% }); %>
              </tbody>
            </table>
          </section>
        <% } %>

        <% if (gallery.length) { %>
          <section class="pd-section">
            <h2>تصاویر محصول</h2>
            <div class="gal">
              <% gallery.forEach(function (g) { %>
                <a href="<%= g.url %>" target="_blank" rel="noopener">
                  <img src="<%= g.url %>" alt="<%= g.alt || p.name %>" loading="lazy">
                </a>
              <% }); %>
            </div>
          </section>
        <% } %>

        <section class="pd-section" id="inquiry">
          <h2>استعلام قیمت و مشاورهٔ خرید</h2>
          <% if (sent) { %>
            <div class="alert alert-success">درخواست شما ثبت شد. کارشناسان ما به‌زودی با شما تماس می‌گیرند.</div>
          <% } %>
          <form method="post" action="/products/<%= p.slug %>/inquiry" class="form-grid">
            <div class="field"><label>نام و نام خانوادگی *</label><input type="text" name="name" required maxlength="120"></div>
            <div class="field"><label>شمارهٔ تماس *</label><input type="tel" name="phone" required maxlength="30" placeholder="۰۹۱۲۰۰۰۰۰۰۰"></div>
            <div class="field"><label>شهر</label><input type="text" name="city" maxlength="80"></div>
            <div class="field"><label>ایمیل</label><input type="email" name="email" maxlength="120"></div>
            <div class="field" style="grid-column:1/-1"><label>توضیحات</label><textarea name="message" maxlength="1000" placeholder="سؤال یا درخواست خود را بنویسید..."></textarea></div>
            <div style="grid-column:1/-1;display:flex;align-items:center;gap:14px;flex-wrap:wrap">
              <button class="btn btn-on-dark" type="submit">ارسال درخواست</button>
              <span style="font-size:11.5px;color:var(--on-dark-muted)">اطلاعات شما محفوظ است.</span>
            </div>
          </form>
        </section>
      </div>

      <aside class="pd-side">
        <div class="pd-card">
          <h3>درخواست سریع</h3>
          <p>برای دریافت کاتالوگ و شرایط فروش تماس بگیرید.</p>
          <div class="side-actions">
            <a href="tel:<%= U.faToEnDigits(s.sales_phone || s.phone) %>" class="btn btn-on-dark btn-sm" dir="ltr"><%= U.toFa(s.sales_phone || s.phone) %></a>
            <a href="<%= s.sale_url %>" target="_blank" rel="noopener" class="btn btn-outline-dark btn-sm">سامانه فروش اینترنتی</a>
            <% if (brochure) { %><a href="<%= brochure.url %>" class="btn btn-outline-dark btn-sm" download>کاتالوگ PDF</a><% } %>
          </div>
        </div>

        <div class="pd-card">
          <h3>ویژگی‌های کلیدی</h3>
          <div class="kv"><span>موتور</span><b><%= p.engine || '—' %></b></div>
          <div class="kv"><span>گیربکس</span><b><%= p.transmission || '—' %></b></div>
          <div class="kv"><span>سوخت</span><b><%= p.fuel || '—' %></b></div>
          <div class="kv"><span>وضعیت</span><b><%= U.STATUS_LABELS[p.status] || 'موجود' %></b></div>
        </div>

        <% if (related.length) { %>
          <div class="pd-card">
            <h3>محصولات دیگر</h3>
            <% related.forEach(function (r) { %>
              <a class="pd-related" href="/products/<%= r.slug %>">
                <% if (r.coverUrl) { %><img src="<%= r.coverUrl %>" alt="" loading="lazy"><% } %>
                <span>
                  <b><%= r.name %></b>
                  <small><% if (r.price) { %><%= U.money(r.price) %> تومان<% } else { %>استعلام قیمت<% } %></small>
                </span>
              </a>
            <% }); %>
          </div>
        <% } %>

        <div class="pd-card">
          <h3>اشتراک‌گذاری</h3>
          <div class="side-actions">
            <button type="button" class="btn btn-outline-dark btn-sm" onclick="navigator.clipboard&&navigator.clipboard.writeText(location.href).then(()=>this.textContent='کپی شد')">کپی لینک صفحه</button>
            <a class="btn btn-outline-dark btn-sm" href="https://t.me/share/url?url=<%= encodeURIComponent(seo.canonical) %>" target="_blank" rel="noopener">تلگرام</a>
          </div>
        </div>
      </aside>
    </div>
  </div>
</div>
