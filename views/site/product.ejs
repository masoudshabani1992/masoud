<section class="article-hero">
  <div class="container">
    <nav class="breadcrumb" aria-label="مسیر صفحه">
      <a href="/">خانه</a><span>/</span><a href="/products">محصولات</a><span>/</span><span><%= p.name %></span>
    </nav>
    <div style="display:flex;justify-content:space-between;align-items:flex-end;gap:20px;flex-wrap:wrap">
      <div>
        <% if (p.cat_name) { %><span class="badge badge-type"><%= p.cat_name %></span><% } %>
        <h1 style="font-size:32px;margin:10px 0 6px"><%= p.name %></h1>
        <p class="muted" style="margin:0"><%= U.truncate(p.short_desc, 150) %></p>
      </div>
      <div style="text-align:center;background:#fff;border:1px solid var(--line);border-radius:14px;padding:12px 20px">
        <span class="muted" style="font-size:12px">قیمت</span>
        <div style="font-size:20px;font-weight:800;color:var(--brand)">
          <% if (p.price) { %><%= U.money(p.price) %> <small style="font-size:12px;font-weight:500">تومان</small>
          <% } else { %>استعلام<% } %>
        </div>
        <% if (p.price_note) { %><small class="muted"><%= p.price_note %></small><% } %>
      </div>
    </div>
  </div>
</section>

<div class="container">
  <div class="article-layout">
    <article>
      <div class="article-cover" style="background:#f1f6fb;display:grid;place-items:center;min-height:220px">
        <% if (coverImg) { %>
          <img src="<%= coverImg.url %>" alt="<%= coverImg.alt || p.name %>">
        <% } else { %>
          <div style="font-size:64px;padding:50px">🚗</div>
        <% } %>
      </div>

      <% if (gallery.length) { %>
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:26px">
          <% gallery.forEach(function (g) { %>
            <a href="<%= g.url %>" target="_blank" rel="noopener" style="border-radius:10px;overflow:hidden;border:1px solid var(--line)">
              <img src="<%= g.url %>" alt="<%= g.alt || p.name %>" style="aspect-ratio:4/3;object-fit:cover" loading="lazy">
            </a>
          <% }); %>
        </div>
      <% } %>

      <div class="content">
        <%- p.body || '<p>' + p.short_desc + '</p>' %>
      </div>

      <% if (specs.length) { %>
        <h2 style="margin-top:40px;font-size:22px">مشخصات فنی</h2>
        <div class="table-wrap">
          <table class="data">
            <tbody>
              <% specs.forEach(function (sp) { %>
                <tr><th style="width:38%"><%= sp.label %></th><td><%= sp.value %></td></tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>

      <div id="inquiry" style="margin-top:44px;background:var(--bg);border:1px solid var(--line);border-radius:16px;padding:28px">
        <h2 style="font-size:20px;margin-bottom:6px">استعلام قیمت و مشاوره خرید</h2>
        <p class="muted" style="font-size:14px">فرم زیر را تکمیل کنید؛ کارشناسان ما در اولین فرصت با شما تماس می‌گیرند.</p>
        <% if (sent) { %>
          <div class="alert alert-success">درخواست شما ثبت شد. کارشناسان ما به‌زودی با شما تماس می‌گیرند.</div>
        <% } %>
        <form method="post" action="/products/<%= p.slug %>/inquiry" class="form-grid">
          <div class="field">
            <label>نام و نام خانوادگی <span style="color:var(--accent)">*</span></label>
            <input type="text" name="name" required maxlength="120">
          </div>
          <div class="field">
            <label>شماره تماس <span style="color:var(--accent)">*</span></label>
            <input type="tel" name="phone" required maxlength="30" placeholder="۰۹۱۲۰۰۰۰۰۰۰">
          </div>
          <div class="field">
            <label>شهر</label>
            <input type="text" name="city" maxlength="80">
          </div>
          <div class="field">
            <label>ایمیل</label>
            <input type="email" name="email" maxlength="120">
          </div>
          <div class="field" style="grid-column:1/-1">
            <label>توضیحات</label>
            <textarea name="message" maxlength="1000" placeholder="سؤال یا درخواست خود را بنویسید..."></textarea>
          </div>
          <div style="grid-column:1/-1">
            <button class="btn btn-primary" type="submit">ارسال درخواست</button>
            <span class="muted" style="font-size:12px;margin-inline-start:10px">اطلاعات شما محفوظ است.</span>
          </div>
        </form>
      </div>
    </article>

    <aside>
      <div class="side-card">
        <h3>ویژگی‌های کلیدی</h3>
        <ul class="side-list">
          <li><b>موتور:</b> <%= p.engine || '—' %></li>
          <li><b>گیربکس:</b> <%= p.transmission || '—' %></li>
          <li><b>سوخت:</b> <%= p.fuel || '—' %></li>
          <li><b>وضعیت:</b> <span class="badge badge-<%= p.status %>"><%= U.STATUS_LABELS[p.status] %></span></li>
        </ul>
      </div>

      <div class="side-card">
        <h3>درخواست سریع</h3>
        <p style="font-size:13.5px;color:var(--muted)">برای دریافت کاتالوگ و شرایط فروش تماس بگیرید.</p>
        <a href="tel:<%= U.faToEnDigits(s.sales_phone || s.phone) %>" class="btn btn-primary" style="width:100%;margin-bottom:8px">
          <%= U.toFa(s.sales_phone || s.phone) %>
        </a>
        <a href="<%= s.sale_url %>" target="_blank" rel="noopener" class="btn btn-ghost" style="width:100%">سامانه فروش اینترنتی</a>
        <div class="share" style="margin-top:14px">
          <button type="button" onclick="navigator.clipboard&&navigator.clipboard.writeText(location.href).then(()=>this.textContent='کپی شد')">کپی لینک</button>
          <a href="https://t.me/share/url?url=<%= encodeURIComponent(seo.canonical) %>" target="_blank" rel="noopener">تلگرام</a>
          <a href="https://wa.me/?text=<%= encodeURIComponent(seo.canonical) %>" target="_blank" rel="noopener">واتساپ</a>
        </div>
      </div>

      <% if (related.length) { %>
        <div class="side-card">
          <h3>محصولات دیگر</h3>
          <ul class="side-list">
            <% related.forEach(function (r) { %>
              <li>
                <a href="/products/<%= r.slug %>" style="display:flex;gap:12px;align-items:center">
                  <span style="flex:0 0 60px;height:46px;border-radius:8px;overflow:hidden;background:#eef4fb;display:grid;place-items:center">
                    <% if (r.coverUrl) { %><img src="<%= r.coverUrl %>" alt="" style="width:100%;height:100%;object-fit:cover">
                    <% } else { %>🚗<% } %>
                  </span>
                  <span><b style="display:block;color:var(--ink);font-size:13.5px"><%= r.name %></b>
                    <small class="muted"><% if (r.price) { %><%= U.money(r.price) %> تومان<% } else { %>استعلام قیمت<% } %></small>
                  </span>
                </a>
              </li>
            <% }); %>
          </ul>
        </div>
      <% } %>
    </aside>
  </div>
</div>
