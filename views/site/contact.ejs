<section class="article-hero">
  <div class="container">
    <nav class="breadcrumb" aria-label="مسیر صفحه"><a href="/">خانه</a><span>/</span><span>تماس با ما</span></nav>
    <h1 style="font-size:32px;margin:0 0 8px">تماس با ما</h1>
    <p class="muted" style="margin:0">کارشناسان کوشا خودرو در روزهای کاری آماده پاسخگویی هستند</p>
  </div>
</section>

<div class="container">
  <div class="article-layout">
    <article>
      <div class="grid grid-3" style="margin-bottom:30px">
        <div class="side-card" style="margin:0;text-align:center">
          <div style="font-size:26px">☎</div>
          <h3 style="font-size:14px">تلفن مرکزی</h3>
          <a href="tel:<%= U.faToEnDigits(s.phone) %>" style="font-weight:800;font-size:16px"><%= U.toFa(s.phone) %></a>
        </div>
        <div class="side-card" style="margin:0;text-align:center">
          <div style="font-size:26px">🛠</div>
          <h3 style="font-size:14px">خدمات پس از فروش</h3>
          <a href="tel:<%= U.faToEnDigits(s.support_phone) %>" style="font-weight:800;font-size:16px"><%= U.toFa(s.support_phone) %></a>
        </div>
        <div class="side-card" style="margin:0;text-align:center">
          <div style="font-size:26px">✉</div>
          <h3 style="font-size:14px">ایمیل</h3>
          <a href="mailto:<%= s.email %>" style="font-weight:700;font-size:13.5px"><%= s.email %></a>
        </div>
      </div>

      <div id="form" class="side-card">
        <h3 style="font-size:18px">ارسال پیام</h3>
        <% if (sent) { %>
          <div class="alert alert-success">پیام شما با موفقیت ثبت شد. به‌زودی با شما تماس می‌گیریم.</div>
        <% } else if (req.query.sent === '0') { %>
          <div class="alert alert-error">نام و شماره تماس الزامی است.</div>
        <% } %>
        <form id="contact-form" method="post" action="/contact" class="form-grid">
          <div class="field"><label>نام و نام خانوادگی *</label><input type="text" name="name" required maxlength="120"></div>
          <div class="field"><label>شماره تماس *</label><input type="tel" name="phone" required maxlength="30"></div>
          <div class="field"><label>ایمیل</label><input type="email" name="email" maxlength="120"></div>
          <div class="field"><label>شهر</label><input type="text" name="city" maxlength="80"></div>
          <div class="field" style="grid-column:1/-1"><label>متن پیام</label><textarea name="message" maxlength="1000"></textarea></div>
          <div style="grid-column:1/-1"><button class="btn btn-primary" type="submit">ارسال پیام</button></div>
        </form>
      </div>
    </article>

    <aside>
      <div class="side-card">
        <h3>دفتر مرکزی</h3>
        <p style="font-size:14px;color:var(--muted);line-height:2"><%= s.address %></p>
        <ul class="side-list">
          <li><b>ساعت کاری:</b> شنبه تا چهارشنبه ۸:۰۰ تا ۱۷:۰۰</li>
          <li><b>پنجشنبه:</b> ۸:۰۰ تا ۱۳:۰۰</li>
        </ul>
      </div>
      <div class="side-card" style="background:linear-gradient(150deg,var(--brand-dark),var(--brand));color:#fff;border:0">
        <h3 style="color:#fff;border-bottom-color:rgba(255,255,255,.2)">سامانه فروش</h3>
        <p style="color:#d6e6f7;font-size:13.5px">ثبت‌نام و مشاهده شرایط فروش محصولات کیا</p>
        <a href="<%= s.sale_url %>" target="_blank" rel="noopener" class="btn btn-light btn-sm" style="width:100%">ورود به سامانه</a>
      </div>
    </aside>
  </div>
</div>
