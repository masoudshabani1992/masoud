<section class="page-hero">
  <div class="wrap">
    <nav class="crumbs" aria-label="مسیر صفحه"><a href="/">خانه</a><span class="sep">/</span><span class="current">تماس با ما</span></nav>
    <h1>تماس با ما</h1>
    <p class="lead">کارشناسان کوشا خودرو در روزهای کاری آمادهٔ پاسخگویی هستند.</p>
  </div>
</section>

<div class="wrap">
  <div class="article-layout">
    <article>
      <div class="grid grid-3" style="margin-bottom:32px">
        <div class="side-card" style="margin:0">
          <h3 style="font-size:12px">تلفن مرکزی</h3>
          <a href="tel:<%= U.faToEnDigits(s.phone) %>" style="font-weight:800;font-size:16px" dir="ltr"><%= U.toFa(s.phone) %></a>
        </div>
        <div class="side-card" style="margin:0">
          <h3 style="font-size:12px">خدمات پس از فروش</h3>
          <a href="tel:<%= U.faToEnDigits(s.support_phone) %>" style="font-weight:800;font-size:16px" dir="ltr"><%= U.toFa(s.support_phone) %></a>
        </div>
        <div class="side-card" style="margin:0">
          <h3 style="font-size:12px">ایمیل</h3>
          <a href="mailto:<%= s.email %>" style="font-weight:700;font-size:13px" dir="ltr"><%= s.email %></a>
        </div>
      </div>

      <div id="form" class="side-card">
        <h3 style="font-size:17px">ارسال پیام</h3>
        <% if (sent) { %>
          <div class="alert alert-success">پیام شما با موفقیت ثبت شد. به‌زودی با شما تماس می‌گیریم.</div>
        <% } else if (req.query.sent === '0') { %>
          <div class="alert alert-error">نام و شمارهٔ تماس الزامی است.</div>
        <% } %>
        <form id="contact-form" method="post" action="/contact" class="form-grid">
          <div class="field"><label>نام و نام خانوادگی *</label><input type="text" name="name" required maxlength="120"></div>
          <div class="field"><label>شمارهٔ تماس *</label><input type="tel" name="phone" required maxlength="30"></div>
          <div class="field"><label>ایمیل</label><input type="email" name="email" maxlength="120"></div>
          <div class="field"><label>شهر</label><input type="text" name="city" maxlength="80"></div>
          <div class="field" style="grid-column:1/-1"><label>متن پیام</label><textarea name="message" maxlength="1000"></textarea></div>
          <div style="grid-column:1/-1"><button class="btn btn-solid" type="submit">ارسال پیام</button></div>
        </form>
      </div>
    </article>

    <aside class="side">
      <div class="side-card">
        <h3>دفتر مرکزی</h3>
        <p style="font-size:13.5px;color:var(--muted);line-height:2.05"><%= s.address %></p>
        <ul class="side-list">
          <li><b>ساعت کاری:</b> شنبه تا چهارشنبه ۸:۰۰ تا ۱۷:۰۰</li>
          <li><b>پنجشنبه:</b> ۸:۰۰ تا ۱۳:۰۰</li>
        </ul>
      </div>
      <div class="side-card side-card-dark">
        <h3>سامانه فروش</h3>
        <p>ثبت‌نام و مشاهدهٔ شرایط فروش محصولات کیا</p>
        <a href="<%= s.sale_url %>" target="_blank" rel="noopener" class="btn btn-on-dark btn-sm" style="width:100%">ورود به سامانه</a>
      </div>
      <div class="side-card">
        <h3>دسترسی سریع</h3>
        <ul class="side-list">
          <li><a href="/dealers">شبکهٔ عاملیت‌ها</a></li>
          <li><a href="/prices">لیست قیمت</a></li>
          <li><a href="/circulars">بخشنامه‌های رسمی</a></li>
        </ul>
      </div>
    </aside>
  </div>
</div>
