<section class="article-hero">
  <div class="container">
    <nav class="breadcrumb" aria-label="مسیر صفحه">
      <a href="/">خانه</a><span>/</span>
      <a href="/dealers">نمایندگی‌ها</a><span>/</span>
      <a href="/dealers?city=<%= encodeURIComponent(d.city) %>"><%= d.city %></a><span>/</span>
      <span><%= U.truncate(d.name, 45) %></span>
    </nav>
    <div style="display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap">
      <div>
        <span class="badge badge-type"><%= TYPE_LABELS_DEALER[d.type] || d.type %></span>
        <h1 style="font-size:29px;margin:10px 0 6px"><%= d.name %></h1>
        <p class="muted" style="margin:0"><%= d.city %><% if (d.province && d.province !== d.city) { %> — استان <%= d.province %><% } %></p>
      </div>
      <div class="actions">
        <a class="btn btn-primary" href="tel:<%= U.faToEnDigits(d.phone) %>" dir="ltr">☎ <%= U.toFa(d.phone) %></a>
        <% if (d.map_url) { %><a class="btn btn-ghost" href="<%= d.map_url %>" target="_blank" rel="noopener">مسیریابی روی نقشه</a><% } %>
      </div>
    </div>
  </div>
</section>

<div class="container">
  <div class="article-layout">
    <article>
      <!-- مشخصات تماس -->
      <div class="side-card" style="margin-bottom:26px">
        <h3>اطلاعات تماس و آدرس</h3>
        <div class="table-wrap" style="border:0">
          <table class="data">
            <tbody>
              <% if (d.address) { %><tr><th style="width:30%">آدرس</th><td><%= d.address %></td></tr><% } %>
              <tr><th>تلفن</th><td dir="ltr"><a href="tel:<%= U.faToEnDigits(d.phone) %>"><%= U.toFa(d.phone) %></a></td></tr>
              <% if (d.mobile) { %><tr><th>همراه</th><td dir="ltr"><%= U.toFa(d.mobile) %></td></tr><% } %>
              <% if (d.email) { %><tr><th>ایمیل</th><td dir="ltr"><a href="mailto:<%= d.email %>"><%= d.email %></a></td></tr><% } %>
              <% if (d.hours) { %><tr><th>ساعات کاری</th><td><%= d.hours %></td></tr><% } %>
              <% if (d.manager) { %><tr><th>مدیر</th><td><%= d.manager %></td></tr><% } %>
              <% if (d.code) { %><tr><th>کد عاملیت</th><td class="mono"><%= U.toFa(d.code) %></td></tr><% } %>
            </tbody>
          </table>
        </div>
        <% if (services.length) { %>
          <div class="dealer-services" style="margin-top:14px">
            <span class="small muted" style="margin-inline-end:6px">خدمات:</span>
            <% services.forEach(function (sv) { %><span class="chip chip-sm"><%= sv %></span><% }); %>
          </div>
        <% } %>
      </div>

      <!-- لیست قیمت این نمایندگی -->
      <div class="section-head" style="margin-bottom:16px">
        <div>
          <span class="kicker">لیست قیمت</span>
          <h2 style="font-size:22px">قیمت محصولات برای این <%= d.type === 'agency' ? 'عاملیت' : 'نمایندگی' %></h2>
          <p><%= priceList ? priceList.title : 'لیست قیمت اختصاصی ثبت نشده است.' %></p>
        </div>
        <% if (priceList) { %>
          <a class="more" href="/prices/<%= priceList.slug %>">مشاهده لیست کامل ←</a>
        <% } %>
      </div>

      <% if (priceList && items.length) { %>
        <% if (priceList.effective_from || priceList.effective_to) { %>
          <div class="alert alert-info" style="margin-bottom:16px">
            اعتبار لیست: <%= U.faDate(priceList.effective_from) %> تا <%= U.faDate(priceList.effective_to) %>
          </div>
        <% } %>
        <div class="table-wrap">
          <table class="data price-table">
            <thead>
              <tr>
                <th>محصول</th>
                <th>مدل / رنگ</th>
                <th>قیمت پایه (تومان)</th>
                <th>سهم عاملیت</th>
                <th>قیمت شما</th>
                <th>قیمت مصرف‌کننده</th>
                <th>تحویل</th>
              </tr>
            </thead>
            <tbody>
              <% items.forEach(function (it) { %>
                <tr>
                  <td class="title-cell">
                    <% if (it.product_slug) { %><a href="/products/<%= it.product_slug %>"><%= it.product_name %></a>
                    <% } else { %><%= it.label %><% } %>
                  </td>
                  <td class="small muted"><%= it.model_year || '—' %> · <%= it.color || '—' %></td>
                  <td class="num"><%= U.money(it.base_price) || '—' %></td>
                  <td class="num" style="color:#147a3f"><%= U.money(it.dealer_discount) || '—' %></td>
                  <td class="num" style="font-weight:800;color:var(--brand)"><%= U.money(it.final_price) || '—' %></td>
                  <td class="num muted"><%= U.money(it.public_price) || '—' %></td>
                  <td class="small"><%= it.delivery || '—' %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <% if (priceList.notes) { %>
          <div class="alert alert-info" style="margin-top:14px"><span>ℹ️</span><span><%= priceList.notes %></span></div>
        <% } %>
      <% } else { %>
        <div class="empty-state" style="padding:40px 20px">
          <div class="icon">🧾</div>
          <p>برای این مرکز هنوز لیست قیمت منتشر نشده است. با بخش فروش تماس بگیرید.</p>
          <a href="/prices" class="btn btn-ghost btn-sm">مشاهده لیست‌های قیمت</a>
        </div>
      <% } %>

      <% if (coverImg) { %>
        <div class="article-cover" style="margin-top:26px"><img src="<%= coverImg.url %>" alt="<%= coverImg.alt || d.name %>"></div>
      <% } %>
    </article>

    <aside>
      <div class="side-card" style="background:linear-gradient(150deg,var(--brand-dark),var(--brand));color:#fff;border:0">
        <h3 style="color:#fff;border-bottom-color:rgba(255,255,255,.2)">ارتباط مستقیم</h3>
        <p style="color:#d6e6f7;font-size:13.5px">برای استعلام موجودی و شرایط فروش، با این مرکز تماس بگیرید.</p>
        <a href="tel:<%= U.faToEnDigits(d.phone) %>" class="btn btn-light" style="width:100%;margin-bottom:8px" dir="ltr">☎ <%= U.toFa(d.phone) %></a>
        <% if (d.email) { %><a href="mailto:<%= d.email %>" class="btn btn-light btn-sm" style="width:100%">ارسال ایمیل</a><% } %>
      </div>

      <% if (siblings.length) { %>
        <div class="side-card">
          <h3>سایر مراکز در <%= d.city %></h3>
          <ul class="side-list">
            <% siblings.forEach(function (x) { %>
              <li>
                <a href="/dealers/<%= x.slug %>"><%= x.name %></a>
                <span class="date"><%= TYPE_LABELS_DEALER[x.type] || x.type %></span>
              </li>
            <% }); %>
          </ul>
        </div>
      <% } %>

      <div class="side-card">
        <h3>شهرهای دیگر</h3>
        <ul class="side-list">
          <% nearby.forEach(function (x) { %>
            <li><a href="/dealers/<%= x.slug %>"><%= x.city %> — <%= U.truncate(x.name, 40) %></a></li>
          <% }); %>
        </ul>
        <a href="/dealers" class="btn btn-ghost btn-sm" style="width:100%;margin-top:12px">همه نمایندگی‌ها</a>
      </div>
    </aside>
  </div>
</div>
