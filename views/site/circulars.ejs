<section class="page-hero">
  <div class="wrap">
    <nav class="crumbs" aria-label="مسیر صفحه">
      <a href="/">خانه</a><span class="sep">/</span><a href="/circulars">بخشنامه‌ها</a>
      <% if (activeCat) { %><span class="sep">/</span><span class="current"><%= activeCat.name %></span><% } %>
    </nav>
    <h1>بخشنامه‌ها و اطلاعیه‌های رسمی</h1>
    <p class="lead">آرشیو دستورالعمل‌های فروش، خدمات پس از فروش و اطلاعیه‌های رسمی برای عاملیت‌ها و مشتریان.</p>
  </div>
</section>

<div class="wrap on-light" style="padding-top:34px;padding-bottom:76px">
  <div class="filters">
    <a class="chip <%= !activeCat ? 'active' : '' %>" href="/circulars">همه</a>
    <% cats.forEach(function (c) { %>
      <a class="chip <%= activeCat && activeCat.slug === c.slug ? 'active' : '' %>" href="/circulars?cat=<%= c.slug %>"><%= c.name %></a>
    <% }); %>
    <form class="search-box" method="get" action="/circulars" data-quick-search>
      <% if (activeCat) { %><input type="hidden" name="cat" value="<%= activeCat.slug %>"><% } %>
      <input type="search" name="q" value="<%= q %>" placeholder="جست‌وجو در بخشنامه‌ها...">
    </form>
  </div>

  <% if (!items.length) { %>
    <div class="empty-state">
      <div class="icon">—</div>
      <h2>بخشنامه‌ای یافت نشد</h2>
      <p>در این دسته هنوز بخشنامه‌ای منتشر نشده است.</p>
      <a href="/circulars" class="btn btn-solid btn-sm">مشاهدهٔ همه</a>
    </div>
  <% } else { %>
    <div class="crc-wrap">
      <% items.forEach(function (c) { %>
        <article class="crc-row">
          <div class="crc-date">
            <b><%= U.faDateShort(c.doc_date || c.published_at).split('/')[2] || '—' %></b>
            <span><%= U.faDate(c.doc_date || c.published_at).split(' ').slice(0, 2).join(' ') %></span>
          </div>
          <div class="crc-main">
            <div class="crc-tags">
              <% if (c.cat_name) { %><span class="crc-cat"><%= c.cat_name %></span><% } %>
              <% if (c.doc_number) { %><span class="crc-no">شمارهٔ <%= U.toFa(c.doc_number) %></span><% } %>
              <% if (c.pinned) { %><span class="crc-pin">مهم</span><% } %>
            </div>
            <h3><a href="/circular/<%= c.slug %>"><%= c.title %></a></h3>
            <p><%= U.truncate(c.excerpt || c.body, 165) %></p>
          </div>
          <a class="crc-go" href="/circular/<%= c.slug %>" aria-label="مشاهدهٔ بخشنامه">←</a>
        </article>
      <% }); %>
    </div>

    <% if (pg.pages > 1) { %>
      <nav class="pagination" aria-label="صفحه‌بندی">
        <% for (var i = 1; i <= pg.pages; i++) { %>
          <% if (i === pg.page) { %>
            <span class="current"><%= U.toFa(i) %></span>
          <% } else { %>
            <a href="<%= pageUrl('/circulars', query, i) %>"><%= U.toFa(i) %></a>
          <% } %>
        <% } %>
      </nav>
    <% } %>
  <% } %>
</div>
