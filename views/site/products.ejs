<section class="page-hero">
  <div class="wrap">
    <nav class="crumbs" aria-label="مسیر صفحه">
      <a href="/">خانه</a><span class="sep">/</span><a href="/products">محصولات</a>
      <% if (activeCat) { %><span class="sep">/</span><span class="current"><%= activeCat.name %></span><% } %>
    </nav>
    <h1>محصولات کیا</h1>
    <p class="lead">
      مدل‌های ارائه‌شده توسط کوشا خودرو — با گارانتی رسمی، تأمین قطعات اصلی و خدمات پس از فروش در سراسر کشور.
    </p>
  </div>
</section>

<div class="wrap" style="padding-top:38px;padding-bottom:76px">
  <div class="filters">
    <a class="chip <%= !activeCat ? 'active' : '' %>" href="/products">همهٔ محصولات</a>
    <% cats.forEach(function (c) { %>
      <a class="chip <%= activeCat && activeCat.slug === c.slug ? 'active' : '' %>" href="/products?cat=<%= c.slug %>"><%= c.name %></a>
    <% }); %>
  </div>

  <div class="grid grid-3">
    <% items.forEach(function (p) { %>
      <article class="card product-card">
        <a href="/products/<%= p.slug %>" class="card-thumb">
          <% if (p.coverUrl) { %><img src="<%= p.coverUrl %>" alt="<%= p.name %>" loading="lazy">
          <% } else { %><span class="placeholder">KIA</span><% } %>
        </a>
        <div class="card-body">
          <div class="card-meta">
            <% if (p.cat_name) { %><span class="tag"><%= p.cat_name %></span><% } %>
            <span class="badge badge-<%= p.status %>"><%= U.STATUS_LABELS[p.status] || 'موجود' %></span>
          </div>
          <h3><a href="/products/<%= p.slug %>"><%= p.name %></a></h3>
          <p><%= U.truncate(p.short_desc, 108) %></p>
          <% if (p.specs && p.specs.length) { %>
            <ul style="list-style:none;padding:0;margin:0 0 6px;display:grid;gap:7px;font-size:12.5px;color:var(--muted)">
              <% p.specs.slice(0, 3).forEach(function (sp) { %>
                <li style="display:flex;justify-content:space-between;gap:10px;border-bottom:1px solid var(--line-2);padding-bottom:6px">
                  <span><%= sp.label %></span><b style="color:#26272b;font-weight:600"><%= sp.value %></b>
                </li>
              <% }); %>
            </ul>
          <% } %>
          <div class="foot">
            <span class="price">
              <% if (p.price) { %><%= U.money(p.price) %> <small>تومان</small><% } else { %>استعلام قیمت<% } %>
            </span>
            <a href="/products/<%= p.slug %>" class="btn btn-solid btn-sm">مشخصات و کاتالوگ</a>
          </div>
        </div>
      </article>
    <% }); %>
  </div>

  <% if (!items.length) { %>
    <div class="empty-state"><div class="icon">—</div><h2>محصولی ثبت نشده</h2><p>به‌زودی محصولات این دسته منتشر می‌شود.</p></div>
  <% } %>

  <div class="cta-band" style="margin-top:48px">
    <div>
      <h2>مشاورهٔ تخصصی خرید</h2>
      <p>برای دریافت کاتالوگ، شرایط فروش و مشاوره، با کارشناسان کوشا خودرو تماس بگیرید.</p>
    </div>
    <a href="/contact" class="btn btn-on-dark">تماس با ما</a>
  </div>
</div>
